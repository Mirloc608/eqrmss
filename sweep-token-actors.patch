+/**
+ * The sweep universe (2026-11-06): base world actors PLUS the actors
+ * of tokens placed on the active scene. Aggro records — like the
+ * spell effects the bard-playlist "Fix A" sweep hunts (crit-
+ * conditions.js, 2026-11-04) — are stamped on token actors in play,
+ * and unlinked token actors are not in game.actors, so a sweep over
+ * game.actors alone misses the mobs actually in the encounter.
+ * Deduped by actor id: a linked token's actor IS the base actor,
+ * and accumulating sweeps (recordHealAggro) must never count one
+ * mob twice.
+ *
+ * @returns {Actor[]} deduplicated actors to sweep
+ */
+export function sweepActors() {
+    const byId = new Map();
+    try {
+        for (const a of globalThis.game?.actors?.contents ?? []) {
+            if (a?.id && !byId.has(a.id)) byId.set(a.id, a);
+        }
+    } catch (e) { /* ignore */ }
+    try {
+        for (const t of globalThis.game?.canvas?.tokens?.placeables ?? []) {
+            const a = t?.actor;
+            if (a?.id && !byId.has(a.id)) byId.set(a.id, a);
+        }
+    } catch (e) { /* ignore */ }
+    return [...byId.values()];
+}
