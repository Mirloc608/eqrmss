{"_id":"city000000000001","name":"Cabilis","type":"city","img":"systems/eqrmss/assets/cities/cabilis.webp","system":{"description":"The ancient capital of the Iksar Empire on Kunark. A city of proud warriors, scholars, and priests devoted to the old traditions of the Shissar and the teachings of Cabilis.","region":"Kunark","continent":"Kunark","raceAffinity":["Iksar"],"faction":"Iksar Empire","alignment":"Neutral Evil"}}
{"_id":"city000000000002","name":"Freeport","type":"city","img":"systems/eqrmss/assets/cities/freeport.webp","system":{"description":"A massive human port city on Antonica. Freeport is a center of trade, military power, and adventuring opportunity.","region":"Eastern Antonica","continent":"Antonica","raceAffinity":["Human","Half-Elf","Halfling"],"faction":"Freeport Militia","alignment":"Neutral"}}
{"_id":"city000000000003","name":"Qeynos","type":"city","img":"systems/eqrmss/assets/cities/qeynos.webp","system":{"description":"A bastion of civilization on western Antonica. Qeynos is known for honorable knights, skilled craftsmen, and defenders of good.","region":"Western Antonica","continent":"Antonica","raceAffinity":["Human","Halfling","Half-Elf"],"faction":"Qeynos Guard","alignment":"Lawful Good"}}
{"_id":"city000000000004","name":"Neriak","type":"city","img":"systems/eqrmss/assets/cities/neriak.webp","system":{"description":"The subterranean capital of the Teir'Dal. Neriak is a city of shadow magic, intrigue, and devotion to dark deities.","region":"Nektulos Forest","continent":"Antonica","raceAffinity":["Dark Elf"],"faction":"Teir'Dal","alignment":"Evil"}}
