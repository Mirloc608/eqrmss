{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EQ-RMSS Race Definition - Canonical Schema (based on gnome.json)",
  "type": "object",
  "required": [
    "id",
    "key",
    "name",
    "type",
    "img",
    "description",
    "lore",
    "stats",
    "racialTalents",
    "movement",
    "size",
    "height",
    "weight",
    "lifespan",
    "skillBonuses",
    "skillCosts",
    "favoredProfessions",
    "restrictedProfessions",
    "startingLanguages",
    "startingEquipment"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^eqrmss-[a-z-]+$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z-]+$"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "race"
    },
    "img": {
      "type": "string",
      "pattern": "^systems/eqrmss/assets/Icons/race/.+\\.png$"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "lore": {
      "type": "object",
      "required": [
        "homeland",
        "culture",
        "alignment",
        "languages"
      ],
      "properties": {
        "homeland": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "culture": {
          "type": "string"
        },
        "alignment": {
          "type": "string"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "Ag",
        "Co",
        "Me",
        "Re",
        "SD",
        "Em",
        "In",
        "Pr",
        "Qu",
        "St"
      ],
      "additionalProperties": false,
      "properties": {
        "Ag": {
          "type": "number"
        },
        "Co": {
          "type": "number"
        },
        "Me": {
          "type": "number"
        },
        "Re": {
          "type": "number"
        },
        "SD": {
          "type": "number"
        },
        "Em": {
          "type": "number"
        },
        "In": {
          "type": "number"
        },
        "Pr": {
          "type": "number"
        },
        "Qu": {
          "type": "number"
        },
        "St": {
          "type": "number"
        }
      }
    },
    "racialTalents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "effects"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "target",
                "value"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "skillCategory",
                    "affinity",
                    "stat",
                    "resistance",
                    "sense",
                    "armor",
                    "movement",
                    "regeneration"
                  ]
                },
                "target": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "movement": {
      "type": "object",
      "required": [
        "base",
        "pace",
        "encumbranceMultiplier"
      ],
      "properties": {
        "base": {
          "type": "number"
        },
        "pace": {
          "type": "string",
          "enum": [
            "Slow",
            "Normal",
            "Fast"
          ]
        },
        "encumbranceMultiplier": {
          "type": "number"
        }
      }
    },
    "size": {
      "type": "string",
      "enum": [
        "Small",
        "Medium",
        "Large"
      ]
    },
    "height": {
      "type": "object",
      "required": [
        "male",
        "female"
      ],
      "properties": {
        "male": {
          "type": "string"
        },
        "female": {
          "type": "string"
        }
      }
    },
    "weight": {
      "type": "object",
      "required": [
        "male",
        "female"
      ],
      "properties": {
        "male": {
          "type": "string"
        },
        "female": {
          "type": "string"
        }
      }
    },
    "lifespan": {
      "type": "object",
      "required": [
        "average"
      ],
      "properties": {
        "average": {
          "type": "string"
        }
      }
    },
    "skillBonuses": {
      "type": "object",
      "required": [
        "combat",
        "physical",
        "subterfuge",
        "magical",
        "lore",
        "social"
      ],
      "additionalProperties": false,
      "properties": {
        "combat": {
          "type": "object"
        },
        "physical": {
          "type": "object"
        },
        "subterfuge": {
          "type": "object"
        },
        "magical": {
          "type": "object"
        },
        "lore": {
          "type": "object"
        },
        "social": {
          "type": "object"
        }
      }
    },
    "skillCosts": {
      "type": "object",
      "required": [
        "combat",
        "physical",
        "subterfuge",
        "magical",
        "lore",
        "social"
      ],
      "properties": {
        "combat": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "physical": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "subterfuge": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "magical": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "lore": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "social": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        }
      }
    },
    "favoredProfessions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restrictedProfessions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "startingLanguages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "rank"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "rank": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "startingEquipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
